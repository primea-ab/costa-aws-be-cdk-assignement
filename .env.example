# Copy this file to .env and fill in the values for your environment.
# .env is gitignored and should never be committed.

# ---- Target environment ----
# "local" uses LocalStack + local MongoDB via Docker
# "aws"   uses real AWS + MongoDB Atlas (or other remote MongoDB)
DEPLOY_TARGET=local

# ---- MongoDB ----
# Local (Docker):  mongodb://mongodb:27017/fleet   ← use Docker service name, not localhost
#                  Lambda runs inside Docker and cannot reach host's localhost
# AWS/Atlas:       mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fleet
MONGODB_URI=mongodb://mongodb:27017/fleet

# ---- AWS ----
# LocalStack Community always uses account 000000000000 and region us-east-1
# regardless of what is configured here. These values matter for real AWS deploys.
AWS_ACCOUNT=000000000000
AWS_REGION=us-east-1
